{
  "expo": {
    "name": "ZenTime",
    "slug": "MyNewApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "zentime",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to take attendance photos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library.",
        "NSLocationWhenInUseUsageDescription": "ZenTime uses your location to mark attendance.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ZenTime uses your location for attendance tracking.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.wingroo.MyNewApp"
    },
    "android": {
      "package": "com.wingroo.MyNewApp",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCOWhjk4Qxz3spiNz2BKgmQqdrO2vE6YL0"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ZenTime to access your camera to take attendance photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ZenTime to access your gallery.",
          "cameraPermission": "Allow ZenTime to use your camera."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ZenTime to use your location for attendance tracking.",
          "locationAlwaysAndWhenInUsePermission": "Allow ZenTime to track your location while using the app.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0ee88fba-99af-453e-b449-0caedc768560"
      }
    },
    "owner": "wingroo"
  }
}
